{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "functions/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "source": "/downloads/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/api/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/api/releases/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/downloads/latest/:file",
        "destination": "/dl/v1.6.2.2/:file",
        "type": 302
      },
      {
        "source": "/dmca",
        "destination": "/docs/legal/#reporting-content-you-own",
        "type": 301
      },
      {
        "source": "/legal",
        "destination": "/docs/legal/",
        "type": 301
      },
      {
        "source": "/releases/latest",
        "destination": "/releases/v1.6.2.2/",
        "type": 302
      },
      {
        "source": "/releases/tag/:tag",
        "destination": "/releases/:tag/",
        "type": 301
      },
      {
        "source": "/releases/download/:tag/:file",
        "destination": "/dl/:tag/:file",
        "type": 302
      },
      {
        "source": "/obtainium",
        "destination": "https://apps.obtainium.imranr.dev/redirect?r=obtainium%3A%2F%2Fapp%2F%257B%2522id%2522%253A%2522com.pokedaisy.app%2522%252C%2522url%2522%253A%2522https%253A%252F%252Fpokedaisy.com%252Freleases%252Flatest%2522%252C%2522author%2522%253A%2522PokeDaisy%2522%252C%2522name%2522%253A%2522PokeDaisy%2522%252C%2522overrideSource%2522%253A%2522HTML%2522%252C%2522additionalSettings%2522%253A%2522%257B%255C%2522versionExtractionRegEx%255C%2522%253A%255C%2522PokeDaisy-(%255B0-9.%255D%252B)%255C%255C%255C%255C.apk%255C%2522%252C%255C%2522matchGroupToUse%255C%2522%253A%255C%25221%255C%2522%252C%255C%2522apkFilterRegEx%255C%2522%253A%255C%2522PokeDaisy-%255B0-9.%255D%252B%255C%255C%255C%255C.apk%255C%2522%257D%2522%257D",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/dl/**",
        "function": {
          "functionId": "downloads",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/downloads/v1/count.json",
        "function": {
          "functionId": "downloads",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "hosting": {
      "port": 5055
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8085
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
